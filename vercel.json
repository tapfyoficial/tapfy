{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/video-preview",
      "destination": "/video-preview-static/index.html"
    },
    {
      "source": "/video-preview/(.*)",
      "destination": "/video-preview-static/$1"
    }
  ],
  "functions": {
    "api/tapfy-orders.js": {
      "maxDuration": 30
    }
  }
}
